# Construction Management System (CMS) - Environment Variables Template
# Copy this file to .env.local for local development.

NEXT_PUBLIC_APP_NAME="Construction Management System"
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# Set to "true" only during local UI development/testing without a live backend
NEXT_PUBLIC_ENABLE_MOCK_AUTH="false"

# Session verification endpoint used on initial app load for auth hydration
# Defaults to "/api/v1/auth/session" (uses same-origin reverse proxy / Next.js rewrites)
# Note: If the API is hosted on a different origin (e.g., http://localhost:8080/api/v1/auth/session),
# ensure the backend has CORS enabled with `Access-Control-Allow-Credentials: true` and appropriate
# allowed origins, or configure a Next.js rewrite in next.config.mjs to avoid cross-origin cookie restrictions.
NEXT_PUBLIC_AUTH_SESSION_URL="/api/v1/auth/session"

